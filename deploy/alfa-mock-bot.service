[Unit]
Description=Alfa-Bank mock userscript bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/receipt-bot
EnvironmentFile=/opt/receipt-bot/.env
ExecStart=/opt/receipt-bot/.venv/bin/python -u alfa_mock_bot.py
Restart=always
RestartSec=5
User=root
StandardOutput=append:/var/log/alfa-mock-bot.log
StandardError=append:/var/log/alfa-mock-bot.err.log

[Install]
WantedBy=multi-user.target
