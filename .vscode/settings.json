{
  "git.enabled": false,
  "git.autoRepositoryDetection": false,
  "git.autorefresh": false,
  "git.autofetch": false,
  "git.decorations.enabled": false,
  "git.timeline.enabled": false,
  "scm.diffDecorations": "none",
  "scm.alwaysShowRepositories": false,
  "editor.minimap.enabled": false,
  "editor.largeFileOptimizations": true,
  "search.followSymlinks": false,
  "search.maxResults": 2000,
  "search.searchOnType": false,
  "files.autoGuessEncoding": false,
  "explorer.autoReveal": false,
  "python.analysis.diagnosticMode": "openFilesOnly",
  "python.analysis.indexing": true,
  "python.analysis.userFileIndexingLimit": 200,
  "python.analysis.autoSearchPaths": false,
  "python.analysis.exclude": [
    "**/output/**",
    "**/_test*/**",
    "**/_strict50*/**",
    "**/_proton*/**",
    "**/_quick*/**",
    "**/_bak*/**",
    "**/_tmp*/**",
    "**/tbank-jasper/**",
    "**/tools/apache-maven-3.9.9/**",
    "**/tools/pdf_forge/**",
    "**/__pycache__/**",
    "**/glyph_library/**",
    "**/alfa_glyph_library/**",
    "**/validator_proton_10x/**"
  ],
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/cursor/**": true,
    "**/output/**": true,
    "**/__pycache__/**": true,
    "**/_test*/**": true,
    "**/_strict50*/**": true,
    "**/_proton*/**": true,
    "**/_quick*/**": true,
    "**/_tmp*/**": true,
    "**/_bak*/**": true,
    "**/validator_proton_10x/**": true,
    "**/docs/specimen_*.pdf": true,
    "**/templates/**/*.pdf": true,
    "**/tbank-jasper/**": true,
    "**/tools/apache-maven-3.9.9/**": true,
    "**/tools/pdf_forge/**": true,
    "**/glyph_library/**": true,
    "**/alfa_glyph_library/**": true,
    "**/fonts/**": true,
    "**/*.pdf": true,
    "**/*.jar": true,
    "**/*.pkl": true,
    "**/*.zip": true,
    "**/*.session": true,
    "**/*.session-journal": true
  },
  "search.exclude": {
    "**/output": true,
    "**/__pycache__": true,
    "**/_test*": true,
    "**/_strict50*": true,
    "**/_proton*": true,
    "**/_quick*": true,
    "**/_tmp*": true,
    "**/_bak*": true,
    "**/validator_proton_10x": true,
    "**/tools/apache-maven-3.9.9": true,
    "**/tools/pdf_forge": true,
    "**/tbank-jasper": true,
    "**/glyph_library": true,
    "**/alfa_glyph_library": true,
    "**/*.pdf": true,
    "**/*.pkl": true,
    "**/*.jar": true,
    "**/*.zip": true
  },
  "files.exclude": {
    "**/output": true,
    "**/__pycache__": true,
    "**/_test*": true,
    "**/_strict50*": true,
    "**/_proton*": true,
    "**/_quick*": true,
    "**/_tmp*": true,
    "**/_bak*": true,
    "**/validator_proton_10x": true,
    "**/validator_proton_10x.zip": true,
    "**/tools/apache-maven-3.9.9": true,
    "**/tools/pdf_forge": true,
    "**/tbank-jasper": true,
    "**/*.pdf": true,
    "**/*.pkl": true,
    "**/*.jar": true
  }
}
