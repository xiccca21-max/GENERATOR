# Скопируй этот файл как tg_check.env и заполни значения.
# Файл tg_check.env в git не попадёт (секреты).

# 1) Зайди на https://my.telegram.org → API development tools
# 2) Создай приложение, скопируй api_id и api_hash сюда:
TG_API_ID=12345678
TG_API_HASH=0123456789abcdef0123456789abcdef

# 3) Username бота-чекера (с @ в начале):
TG_CHECKER_BOT=@имя_бота_чекера

# Сколько секунд ждать ответ (по умолчанию 45):
TG_WAIT_SECONDS=45

# Если TimeoutError — включи VPN или укажи локальный SOCKS5 прокси:
# TG_PROXY=socks5://127.0.0.1:10808

# Parallel Fraudex account (не пересекается с OnlyPDF-сессией):
# TG_FRAUDEX_BOT=@FraudexBot
# TG_FRAUDEX_SESSION=.tg_fraudex_session
# Login: python tools/tg_login_fraudex.py
# Run:   python tools/run_strict50_fraudex.py

